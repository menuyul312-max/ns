extends SceneTree
## Godot renderer capture. CPU screenshots are generated by a different tool.

func _initialize() -> void:
	call_deferred("_run")


func _run() -> void:
	var viewport := SubViewport.new()
	viewport.size = Vector2i(1400, 850)
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	root.add_child(viewport)
	var scene: Node3D = load("res://scenes/main.tscn").instantiate()
	scene.manual_actor_control = true
	scene.enable_current = false
	viewport.add_child(scene)
	scene.get_node("EditorHelp").visible = false
	scene.traversal_probe.visible = false
	scene.physics_actor.visible = false
	scene.composer.island = IslandDefinition.fixture_coast_mask()
	scene.show_region_diagnostic = true
	scene.region_diagnostic_mode = 0
	scene._refresh_terrain()
	scene.physics_actor.visible = false
	var camera: Camera3D = scene.reference_camera
	var center := Vector3(10.0 * IslandDefinition.TILE_SIZE, 0.8, 7.0 * IslandDefinition.TILE_SIZE)
	camera.size = 32.0
	camera.position = center + Vector3(18.0, 24.0, 18.0)
	camera.look_at(center)
	for _frame in range(12):
		await process_frame
	var image: Image = viewport.get_texture().get_image()
	if image == null or image.is_empty() or image.save_png(ProjectSettings.globalize_path("res://s48_godot_region_overlay.png")) != OK:
		push_error("Sprint48 Godot capture failed")
		quit(2)
		return
	print("PASS CAPTURE — s48_godot_region_overlay.png from renderer")
	quit(0)
